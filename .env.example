# ── Supabase ────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role / secret key — SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket used for uploaded images
SUPABASE_STORAGE_BUCKET=cms-media